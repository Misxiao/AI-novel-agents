{
  "name": "中文网文写作核心规则包",
  "version": "1.0.0",
  "globalRules": [
    "默认只输出当前最需要的一层，不一次性堆满所有规划。",
    "如果问题已经收束到某个写作环节，优先调用专项模块。",
    "写作前先检索或匹配相似结构，借结构、节奏和诊断维度，不借句面。",
    "结构问题优先于文风问题，不能用润色掩盖因果和人物问题。",
    "每章写完必须进入一致性审查，审查不通过则回到责任模块修复。"
  ],
  "chapterQuestions": [
    "主角这章想做什么？",
    "谁或什么阻止他？",
    "这章结束后局面变成什么？",
    "为什么读者还要往下看？"
  ],
  "sceneMinimum": ["目标", "阻碍", "变化"],
  "reviewChecks": [
    "剧情逻辑一致性",
    "人物目标一致性",
    "情绪与关系一致性",
    "身体与信息状态一致性",
    "场景与转场一致性",
    "章末承接一致性"
  ],
  "moduleRouting": {
    "concept_planning": ["点子", "灵感", "题材", "卖点", "hook", "premise", "故事引擎"],
    "opening": ["开头", "开篇", "第一章", "黄金三章", "抓手"],
    "volume_outline": ["大纲", "分卷", "卷纲", "章纲", "前十章", "卷末"],
    "plot_logic": ["逻辑", "因果", "动机", "触发", "决策", "后果", "伏笔", "兑现"],
    "character_consistency": ["人设", "人物", "目标漂移", "情绪", "关系", "伤势", "口吻"],
    "transition": ["转场", "跳切", "时间", "空间", "承接", "视角", "回忆"],
    "dialogue": ["对白", "台词", "口吻", "摊牌", "说明书", "信息嵌入"],
    "chapter_ending": ["章末", "结尾", "收尾", "钩子", "追更", "余韵"],
    "anti_ai_voice": ["AI味", "模板", "空泛", "套话", "太工整", "机械"],
    "consistency_review": ["审查", "检查", "评审", "完稿", "一致性", "验收"]
  }
