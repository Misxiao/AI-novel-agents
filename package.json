{
  "name": "ai-novel-agents",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "cli": "pnpm --filter @ai-novel-agents/cli start",
    "cli:mock": "pnpm --filter @ai-novel-agents/cli start -- --mock",
    "dev": "pnpm --parallel --filter api --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "typecheck": "pnpm --filter \"./packages/**\" typecheck",
    "test": "pnpm --filter \"./packages/**\" --no-bail test"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
